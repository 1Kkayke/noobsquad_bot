# ============================================
# NoobSquad Discord Bot - Configuration
# ============================================
# Copy this file to `.env` and fill in your values
# NEVER commit the .env file with your actual secrets!

# ============================================
# Discord Configuration (REQUIRED)
# ============================================
# Get your bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here

# Channel ID for music commands (get by right-clicking channel with Developer Mode enabled)
CHAT_JUKEBOX=your_text_channel_id_here

# Channel ID for bot reboot notifications (optional, set to 0 to disable)
REBOOT_CHANNEL_ID=0

# Channel ID for monitoring notifications (optional, set to 0 to disable monitoring)
NOTIFICATION_CHANNEL_ID=0

# ============================================
# MongoDB Configuration (REQUIRED)
# ============================================
# When using Docker Compose, use: mongodb://mongo:27017/noobsquad_bot
# When running locally, use: mongodb://localhost:27017/noobsquad_bot
MONGODB_URI=mongodb://mongo:27017/noobsquad_bot
DATABASE_NAME=noobsquad_bot

# ============================================
# YouTube API Configuration (OPTIONAL)
# ============================================
# Required only for YouTube monitoring features
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ============================================
# Twitch API Configuration (OPTIONAL)
# ============================================
# Required only for Twitch monitoring features
# Get your credentials from: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ============================================
# Monitoring Configuration (OPTIONAL)
# ============================================
# Interval in seconds to check for updates
CHECK_YOUTUBE_INTERVAL=300
CHECK_TWITCH_INTERVAL=180

